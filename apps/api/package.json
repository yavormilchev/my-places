{
  "name": "@my-places/api",
  "version": "0.0.0",
  "private": true,
  "description": "Places API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "import": "tsx src/scripts/import-places.ts",
    "migrate": "node-pg-migrate --envPath ../../.env",
    "migrate:test": "node-pg-migrate --envPath ../../.env -d TEST_DATABASE_URL"
  },
  "dependencies": {
    "@my-places/shared": "*",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "esbuild": "^0.28.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.8"
  }
}
